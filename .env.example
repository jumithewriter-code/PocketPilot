# Copy to .env in the project root. Read by the coach server only (npm run server in web/); never sent to the browser. Do not commit .env.
# Without a key the app still works and uses its built-in (non-AI) explainer.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
COACH_MODEL=
# Optional. Defaults to 8787.
PORT=
